# Production Environment Variables
# Copy to .env on Vercel (Dashboard → Settings → Environment Variables)

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Pooled connection for app queries (pgbouncer)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Direct connection for migrations (prisma db push / migrate)
DATABASE_DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Image Storage (Vercel Blob) ───────────────────────────────────────────────
# Generated automatically when you add Vercel Blob in project settings
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"

# ── Admin Auth ────────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@soweread.com"
ADMIN_PASSWORD="use-a-strong-password-here"

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-64-char-hex-string"

# ── Site URL (no trailing slash) ─────────────────────────────────────────────
# Primary deployment keeps this at https://soweread.com
# Backup deployment must set this to the backup hostname, e.g. https://backup.example.com
NEXT_PUBLIC_SITE_URL="https://soweread.com"

# ── Deployment role ──────────────────────────────────────────────────────────
# Every deployment plays exactly one role per request:
#   primary = the soweread.com content platform
#   growth  = the public SEO/GEO knowledge site on its own domain (index, follow)
#   backup  = the private WordPress mirror (noindex, follow, never in a sitemap)
#
# How the role is decided:
#   SITE_ROLE_RESOLUTION=env  (default) -> the role is fixed by SITE_ROLE.
#                                          Use this when growth and backup live
#                                          in two separate Vercel Projects.
#   SITE_ROLE_RESOLUTION=host           -> the role is resolved per request from
#                                          the Host header against GROWTH_SITE_URL
#                                          and BACKUP_SITE_URL. Use this when ONE
#                                          Vercel Project serves both domains.
#
# Anything that cannot be resolved fails closed: unknown hosts get 503 + noindex,
# and a role whose required variables are missing serves no content.
SITE_ROLE_RESOLUTION="env"
SITE_ROLE="primary"

# Host mode only. Each must be a distinct hostname.
GROWTH_SITE_URL=""
BACKUP_SITE_URL=""

# Host mode only, OPTIONAL. Role to assume for hosts that match nothing (Vercel
# preview URLs). Leave empty in Production so unknown hosts keep failing closed;
# set it to "growth" in the Preview environment if you want preview builds usable.
SITE_ROLE_FALLBACK=""

# ── Backup Site Strategy ─────────────────────────────────────────────────────
# `redirect` = 307 temporary redirect to PRIMARY_SITE_URL
# `serve` = render local backup content
BACKUP_MODE="serve"

# Primary authority URL used for canonical and redirect targets
PRIMARY_SITE_URL="https://soweread.com"

# Public read-only WordPress REST API endpoint
WORDPRESS_API_URL="https://soweread.com/wp-json/wp/v2"

# Required for `/api/sync/wordpress` and Vercel cron authorization
CRON_SECRET="replace-with-a-long-random-string"

# ── Per-role databases ───────────────────────────────────────────────────────
# The growth site and the WordPress mirror must never share a database: the
# mirror must be unreachable from the public growth domain.
#
# SITE_ROLE_RESOLUTION=env  -> each Vercel Project sets its own DATABASE_URL and
#                              these two may stay empty.
# SITE_ROLE_RESOLUTION=host -> BOTH are required and must differ, otherwise the
#                              growth role refuses to serve any content.
GROWTH_DATABASE_URL=""
BACKUP_DATABASE_URL=""

# ── Growth fixture ───────────────────────────────────────────────────────────
# Loads the checked-in test knowledge graph when the growth database is empty or
# unreachable. Leave unset (or "false") in production: the fixture is clearly
# labelled test data with placeholder sources and must never be published.
GROWTH_USE_FIXTURE="false"

# ── Growth on a Vercel-provided domain ───────────────────────────────────────
# A Vercel project answers on more than one *.vercel.app alias (for example
# both <project>.vercel.app and <project>-<scope>.vercel.app), and all of them
# serve the same production deployment. Left alone, the growth site duplicates
# itself across those aliases.
#
# "true" makes every non-canonical alias 308-redirect to the host in
# NEXT_PUBLIC_SITE_URL / GROWTH_SITE_URL. Turn it on in Production for the
# growth role; leave it off in Preview so preview URLs stay reachable.
GROWTH_ENFORCE_CANONICAL_HOST="false"

# A *.vercel.app host cannot be verified with a Search Console DNS domain
# property, so use a URL-prefix property and paste the meta tag token here.
GROWTH_SITE_VERIFICATION=""

# ── Google Analytics (growth role only) ──────────────────────────────────────
# GA4 measurement ID. Loaded only when the growth role is healthy, so the
# backup mirror never reports traffic. A measurement ID is public by design
# (it ships in the page HTML); it is an env var so it can differ per project.
#
# Set this in the PRODUCTION environment only. If you add it to "All
# Environments", every preview deployment pollutes the same GA property.
#
# Use a GA4 property dedicated to the growth site — not the one used by
# another site — otherwise growth traffic and referral measurement cannot be
# separated from it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ── Growth weekly report (SEO/GEO opportunity digest) ────────────────────────
# See docs/growth-weekly-report-migration.md for the full plan. Phase 0 only
# needs the OAuth block below to be usable; the GSC/GA4/Gemini variables are
# consumed starting Phase 1.
#
# Google Cloud Console OAuth client (Desktop app type, loopback redirect).
# Scopes: webmasters.readonly + analytics.readonly.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Long-lived refresh token. Obtained once by running `npm run growth:auth`
# locally and pasting the printed value here — never generated in CI. Revoke
# and re-run if it stops working (Google account → Security → Third-party
# access).
GOOGLE_OAUTH_REFRESH_TOKEN=""

# Search Console site URLs to pull query/page data for. Two properties, not
# one: the plan (§1) tracks growth and primary separately. `backup` is
# intentionally excluded — it is noindex and has nothing to measure.
GSC_SITE_URL_GROWTH=""
GSC_SITE_URL_PRIMARY=""

# Index-coverage step (scripts/growth/lib/url-inspection.mjs). Both optional —
# the defaults below are what runs when they are unset, and neither needs a new
# credential: the URL Inspection API uses the same OAuth client and
# webmasters.readonly scope as the Search Analytics calls above.
#   MAX_URLS     how many sitemap URLs to inspect per site per run. Google's
#                quota is 2000/day and 600/min per site; the growth sitemap is
#                ~23 URLs today, so this cap only matters once it grows.
#   CONCURRENCY  parallel inspection requests. Keep it modest to stay well
#                inside the per-minute quota.
GROWTH_COVERAGE_MAX_URLS="100"
GROWTH_COVERAGE_CONCURRENCY="4"

# GA4 property IDs, one per role. Same growth/primary split as the GSC URLs
# above — do not point both at the same property, or per-role traffic can't
# be told apart. (Not the same variable as NEXT_PUBLIC_GA_MEASUREMENT_ID above:
# that one is the public client-side measurement ID; these are server-side
# Data API property IDs used to pull reports.)
GA4_PROPERTY_ID_GROWTH=""
GA4_PROPERTY_ID_PRIMARY=""

# Gemini model used for the Phase 4 GEO citation-tracking batch job (see
# migration doc §2: Batch API, no google_search grounding — this measures the
# model's parametric knowledge of the brand, not live search-grounded
# citation). GEMINI_API_KEY itself already lives in .env.local, not here.
GEMINI_MODEL_CITATIONS=""

# Recipient(s) for the weekly report email (scripts/growth/mail_report.mjs,
# sent by .github/workflows/growth.yml). Comma-separated for multiple
# recipients. SMTP_HOST/PORT/SECURE/USER/PASS already exist in .env.local
# (same variables as the site's lead-notification route) and are reused
# as-is here, not redefined.
GROWTH_REPORT_TO=""
