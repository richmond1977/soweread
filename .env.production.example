# Production Environment Variables
# Copy to .env on Vercel (Dashboard → Settings → Environment Variables)

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Pooled connection for app queries (pgbouncer)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Direct connection for migrations (prisma db push / migrate)
DATABASE_DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Image Storage (Vercel Blob) ───────────────────────────────────────────────
# Generated automatically when you add Vercel Blob in project settings
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"

# ── Admin Auth ────────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@soweread.com"
ADMIN_PASSWORD="use-a-strong-password-here"

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-64-char-hex-string"

# ── Site URL (no trailing slash) ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://soweread.com"
