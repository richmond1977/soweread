generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model Author {
  id        String   @id
  name      String
  email     String   @unique
  role      String
  bio       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
}

model Category {
  id          String   @id
  name        String
  slug        String   @unique
  description String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
}

model Post {
  id                 String    @id
  title              String
  slug               String    @unique
  excerpt            String
  coverImage         String?
  coverImageAlt      String    @default("")
  content            String
  status             String
  publishedAt        DateTime
  contentUpdatedAt   DateTime?
  sourceType         String    @default("native")
  externalSourceId   String?   @unique
  sourceCanonicalUrl String?
  sourceModifiedAt   DateTime?
  sourceHash         String?
  lastSyncedAt       DateTime?
  readingMinutes     Int
  views              Int       @default(0)
  comments           Int       @default(0)
  featured           Boolean   @default(false)
  tagsJson           String    @default("[]")
  faqJson            String    @default("[]")
  showFaq            Boolean   @default(false)
  sourcesJson        String    @default("[]")
  seoTitle           String
  seoDescription     String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  authorId   String
  categoryId String
  author     Author   @relation(fields: [authorId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([sourceType, status])
}

model SyncState {
  key                String    @id
  lastAttemptAt      DateTime?
  lastSuccessAt      DateTime?
  lastError          String?
  lastSuccessSummary String?
  syncedItemCount    Int       @default(0)
  lastDurationMs     Int?
  updatedAt          DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Growth knowledge model (SITE_ROLE=growth only).
//
// These tables live in the growth database. The WordPress mirror lives in the
// backup database and is never joined to anything here: mirror rows must not be
// able to become public growth pages (plan §2, §8.2).
// ─────────────────────────────────────────────────────────────────────────────

model Topic {
  id                String    @id
  slug              String    @unique
  name              String
  summary           String
  definition        String    @default("")
  keyQuestionsJson  String    @default("[]")
  publicationStatus String    @default("draft")
  seoTitle          String    @default("")
  seoDescription    String    @default("")
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  reviewedAt        DateTime?

  entities TopicEntity[]
  articles GrowthArticle[]

  @@index([publicationStatus, sortOrder])
}

model Entity {
  id                String    @id
  slug              String    @unique
  entityType        String
  name              String
  aliasesJson       String    @default("[]")
  description       String
  canonicalUrl      String?
  publicationStatus String    @default("draft")
  seoTitle          String    @default("")
  seoDescription    String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  reviewedAt        DateTime?

  topics            TopicEntity[]
  sources           EntitySource[]
  articles          ArticleEntity[]
  outgoingRelations EntityRelation[] @relation("EntityRelationSubject")
  incomingRelations EntityRelation[] @relation("EntityRelationObject")

  @@index([publicationStatus, entityType])
}

model EntityRelation {
  id              String    @id
  subjectEntityId String
  predicate       String
  objectEntityId  String
  sourceId        String?
  confidence      String    @default("reported")
  note            String    @default("")
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subjectEntity Entity  @relation("EntityRelationSubject", fields: [subjectEntityId], references: [id], onDelete: Cascade)
  objectEntity  Entity  @relation("EntityRelationObject", fields: [objectEntityId], references: [id], onDelete: Cascade)
  source        Source? @relation(fields: [sourceId], references: [id])

  @@unique([subjectEntityId, predicate, objectEntityId])
  @@index([objectEntityId])
}

model Source {
  id          String    @id
  title       String
  publisher   String
  url         String
  sourceType  String    @default("web")
  publishedAt DateTime?
  retrievedAt DateTime
  note        String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entityLinks  EntitySource[]
  articleLinks ArticleSource[]
  relations    EntityRelation[]

  @@index([publisher])
}

model GrowthArticle {
  id              String    @id
  slug            String    @unique
  title           String
  summary         String
  content         String
  editorialStatus String    @default("draft")
  authorName      String
  reviewerName    String    @default("")
  seoTitle        String    @default("")
  seoDescription  String    @default("")
  primaryCtaUrl   String?
  primaryCtaLabel String    @default("")
  datePublished   DateTime?
  dateModified    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  topicId  String?
  topic    Topic?          @relation(fields: [topicId], references: [id])
  entities ArticleEntity[]
  sources  ArticleSource[]

  @@index([editorialStatus, datePublished])
}

model TopicEntity {
  topicId   String
  entityId  String
  sortOrder Int    @default(0)

  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([topicId, entityId])
  @@index([entityId])
}

model ArticleEntity {
  articleId String
  entityId  String
  role      String @default("mentions")

  article GrowthArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  entity  Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([articleId, entityId])
  @@index([entityId])
}

model ArticleSource {
  articleId String
  sourceId  String
  note      String @default("")
  sortOrder Int    @default(0)

  article GrowthArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  source  Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([articleId, sourceId])
  @@index([sourceId])
}

model EntitySource {
  entityId  String
  sourceId  String
  note      String @default("")
  sortOrder Int    @default(0)

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([entityId, sourceId])
  @@index([sourceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Growth weekly report (SEO/GEO opportunity digest), Phase 1: GSC only.
// See docs/growth-weekly-report-migration.md. Snapshots and rendered reports
// live in the database (not git) — the source project's mistake of committing
// raw GSC data to a public repo is the migration doc's trap #1.
// ─────────────────────────────────────────────────────────────────────────────

model GrowthSnapshot {
  id        String   @id
  site      String
  startDate String
  endDate   String
  rawRows   Json
  /// Index coverage from the URL Inspection API: sitemap size, per-URL verdicts
  /// and the summary the weekly report renders. Nullable because snapshots taken
  /// before the coverage step existed have none, and because a site whose
  /// sitemap or inspection call fails still keeps its Search Analytics rows.
  coverage  Json?
  fetchedAt DateTime

  @@unique([site, endDate])
}

model GrowthReport {
  id        String   @id
  startDate String
  endDate   String
  markdown  String   @db.Text
  createdAt DateTime @default(now())

  @@unique([endDate])
}

// SERP 驗證層（2026-09-19，Serper.dev 免費額度）：對 analyze.mjs 分類出的「內容缺口」
// 候選查詢，實際查一次 Google Top 10，判斷知識物件型態，避免把「GSC 有曝光」直接當成
// 「需要新內容」。同樣不進 git（見 GrowthSnapshot 註解的公開 repo 陷阱），(site, endDate)
// 對齊同一次 GrowthSnapshot 的區間，upsert 鍵重跑不會重複。
model SerpSnapshot {
  id              String   @id
  site            String
  endDate         String
  maxQueries      Int
  totalCandidates Int
  resultsJson     Json
  fetchedAt       DateTime

  @@unique([site, endDate])
}

// 改版成效追蹤（純規則，不用 AI，2026-09-24 移植自 WISECODE_Website）：記錄一次
// 頁面改版的基準值（baseline，來自建立當下最新的 GrowthSnapshot），供到期後
// 與最新快照比對前後差值。是否「算成功」由人（Richmond）決定，這裡只存量測
// 結果與人工決定，見 scripts/growth/lib/experiments.mjs、scripts/growth/experiment.mjs。
model Experiment {
  id              String    @id
  site            String
  page            String
  queriesJson     Json
  change          String
  hypothesis      String
  changedAt       String
  reviewAfterDays Int       @default(28)
  baselineJson    Json
  status          String    @default("running") // running | keep | revert | iterate
  decision        String?
  decidedAt       String?
  createdAt       DateTime  @default(now())

  @@index([site, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Growth weekly report, Phase 4: GEO citation tracking (Gemini Batch API, no
// google_search grounding — see docs/growth-weekly-report-migration.md §2).
// Batch jobs are asynchronous (can take hours), so submit and collect are two
// separate scripts running on separate schedule ticks; this table is the
// hand-off between them.
// ─────────────────────────────────────────────────────────────────────────────

model CitationBatchJob {
  id           String    @id
  batchJobId   String    @unique
  status       String    @default("pending") // pending | completed | failed
  queriesJson  Json
  resultsJson  Json?
  submittedAt  DateTime
  completedAt  DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}
